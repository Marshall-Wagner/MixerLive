<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MixerLive</AssemblyName>
    <RootNamespace>MixerLive.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe, taskbar and title-bar icon (WPF windows without their own Icon use the exe's icon). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>MixerLive</Product>
    <AssemblyTitle>MixerLive</AssemblyTitle>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- WFO0003: the WinForms analyzer wants DPI settings in code, but this is a WPF app (manifest is correct for WPF). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray NotifyIcon; keep its namespaces out of the global usings
         so they do not collide with WPF types (Application, MessageBox, Control, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the tray can load the size Windows asks for. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MixerLive.Core\MixerLive.Core.csproj" />
  </ItemGroup>

</Project>
