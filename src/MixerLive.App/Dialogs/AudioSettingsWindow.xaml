<Window x:Class="MixerLive.App.Dialogs.AudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio settings"
        Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="RowBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource RowHint}">
            <Setter Property="Margin" Value="12,4,0,4"/>
        </Style>
        <Style x:Key="MsBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,14,16,14">
        <!-- The four settings, laid out like a sound card's control panel -->
        <Border Style="{StaticResource RowBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sample rate" Style="{StaticResource RowLabel}"/>
                <ComboBox Grid.Column="1" x:Name="RateBox" DisplayMemberPath="Label" SelectionChanged="RateChanged"/>
                <TextBlock Grid.Column="2" Style="{StaticResource RowHint}"
                           Text="Match your DAC's exclusive-mode rate to avoid resampling. Higher rates use more CPU."/>
            </Grid>
        </Border>
        <Border Style="{StaticResource RowBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Buffer size" Style="{StaticResource RowLabel}"/>
                <ComboBox Grid.Column="1" x:Name="BlockBox" DisplayMemberPath="Label" SelectionChanged="Changed"/>
                <TextBlock Grid.Column="2" Style="{StaticResource RowHint}"
                           Text="Audio the mixer handles at a time. Smaller = less delay, more risk of crackles."/>
            </Grid>
        </Border>
        <Border Style="{StaticResource RowBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Latency" Style="{StaticResource RowLabel}"/>
                <ComboBox Grid.Column="1" x:Name="LatencyBox" SelectionChanged="LatencyChanged"/>
                <TextBlock Grid.Column="2" Style="{StaticResource RowHint}"
                           Text="Safety margin for each device. Low = least delay, Safe = fewest crackles."/>
            </Grid>
        </Border>
        <Border Style="{StaticResource RowBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Resampler" Style="{StaticResource RowLabel}"/>
                <ComboBox Grid.Column="1" x:Name="ResamplerBox"/>
                <TextBlock Grid.Column="2" Style="{StaticResource RowHint}"
                           Text="Best = highest quality (recommended). Fast = lighter, for slow CPUs."/>
            </Grid>
        </Border>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,10"
                   Text="If you hear crackles, raise the buffer size one step or set Latency to Safe. OK restarts the audio for a moment."/>

        <!-- Status, like the FiiO / PreSonus panels -->
        <Border Style="{StaticResource RowBox}">
            <StackPanel>
                <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="StatusText" FontFamily="Consolas" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusNote" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Expert settings, hidden until asked for -->
        <ToggleButton x:Name="ExpertToggle" Content="Show expert settings" HorizontalAlignment="Left" Padding="8,3" Margin="0,4,0,0"
                      Checked="ExpertToggled" Unchecked="ExpertToggled"/>
        <StackPanel x:Name="ExpertPane" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"
                       Text="The Latency setting above chooses these for you. Fill in a box only to override that one value; leave it empty to keep Latency's choice."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Input buffer (ms)" VerticalAlignment="Center" Margin="0,4,10,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputBox" Style="{StaticResource MsBox}" TextChanged="Changed"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="InputHint" Style="{StaticResource Hint}"/>

                <TextBlock Grid.Row="1" Text="Output buffer (ms)" VerticalAlignment="Center" Margin="0,4,10,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="OutputBox" Style="{StaticResource MsBox}" TextChanged="Changed"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="OutputHint" Style="{StaticResource Hint}"/>

                <TextBlock Grid.Row="2" Text="Windows output buffer, shared mode (ms)" VerticalAlignment="Center" Margin="0,4,10,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SharedBox" Style="{StaticResource MsBox}" TextChanged="Changed"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SharedHint" Style="{StaticResource Hint}"/>

                <TextBlock Grid.Row="3" Text="Device buffer, exclusive mode (ms)" VerticalAlignment="Center" Margin="0,4,10,4"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ExclusiveBox" Style="{StaticResource MsBox}" TextChanged="Changed"/>
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="ExclusiveHint" Style="{StaticResource Hint}"/>
            </Grid>
        </StackPanel>

        <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="Use defaults" Click="Reset_Click" MinWidth="110"
                    ToolTip="Default buffer size, Latency Normal, Resampler Best and no expert overrides (the sample rate stays)"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
                <Button Content="OK" Click="Ok_Click" MinWidth="90" Style="{StaticResource AccentButton}" IsDefault="True"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
