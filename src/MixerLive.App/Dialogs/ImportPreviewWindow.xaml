<Window x:Class="MixerLive.App.Dialogs.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Voicemeeter settings"
        Width="760" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
            <Run Text="This is what will be imported from "/><Run x:Name="PathRun" FontWeight="SemiBold"/><Run Text=". Your current MixerLive profile will be replaced (you can re-import or load another profile at any time)."/>
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Import" Click="Apply_Click" MinWidth="90" Style="{StaticResource AccentButton}" IsDefault="True"/>
        </StackPanel>

        <TextBox x:Name="SummaryBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
